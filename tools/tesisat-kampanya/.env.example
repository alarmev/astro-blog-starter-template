# Bu dosyayı .env olarak kopyalayın ve doldurun:  cp .env.example .env

# Google Cloud Console > APIs & Services > "Places API (New)" etkinleştirip anahtar oluşturun
GOOGLE_PLACES_API_KEY=

# SMTP (örnekler: Gmail smtp.gmail.com:587 + Uygulama Şifresi, Yandex smtp.yandex.com.tr:465,
# ya da toplu gönderim için Brevo/Mailgun/Amazon SES SMTP bilgileri)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

GONDEREN_EPOSTA=
GONDEREN_AD=Firma Adınız
# "RET" yanıtlarının geleceği adres (boşsa GONDEREN_EPOSTA kullanılır)
RET_EPOSTA=
